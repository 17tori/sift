# ============================================================================
# SIFT configuration. Copy to .env and fill in. Never commit .env.
# ============================================================================
ENVIRONMENT=production
LOG_LEVEL=INFO

# --- Branding (white-label: change without touching code) ------------------
BRAND_NAME=SIFT
BRAND_TAGLINE=Find beyond the image.
BRAND_TAGLINE_RU=Одна фотография. Все маркетплейсы.
BRAND_ACCENT=#526BFF
BRAND_SUPPORT_USERNAME=
BRAND_SUPPORT_EMAIL=

# --- Domain -----------------------------------------------------------------
DOMAIN=sift.example.com
PUBLIC_BASE_URL=https://sift.example.com
WEBAPP_URL=https://sift.example.com/
LETSENCRYPT_EMAIL=admin@example.com

# --- Secrets ----------------------------------------------------------------
# openssl rand -hex 32
SECRET_KEY=
# Comma-separated Telegram user IDs with admin access
ADMIN_TELEGRAM_IDS=

# --- Telegram ---------------------------------------------------------------
BOT_TOKEN=
BOT_USERNAME=
# polling (simplest) | webhook (via nginx on BOT_WEBHOOK_PATH)
BOT_MODE=polling
# openssl rand -hex 24 (required for webhook mode)
BOT_WEBHOOK_SECRET=
BOT_WEBHOOK_PATH=/tg/webhook

# --- Database / cache -------------------------------------------------------
POSTGRES_USER=sift
# openssl rand -hex 24  (and put the same value into DATABASE_URL)
POSTGRES_PASSWORD=
POSTGRES_DB=sift
DATABASE_URL=postgresql+asyncpg://sift:CHANGE_ME@postgres:5432/sift
REDIS_URL=redis://redis:6379/0
BROKER_URL=redis://redis:6379/1
BACKUP_RETENTION_DAYS=14
BACKUP_HOUR_UTC=3

# --- AI ---------------------------------------------------------------------
# Photo analysis (category, attributes, search phrases): gemini | anthropic | openai_compatible | none
VISION_PROVIDER=gemini
GEMINI_API_KEY=
# Check the current model name in Google AI Studio
GEMINI_MODEL=gemini-3.8-flash
# Spare models (comma-separated) used when the main one is overloaded (503/429), times out or is retired
GEMINI_FALLBACK_MODELS=
# Thinking limit for photo tasks: minimal | low | medium | high | default
GEMINI_THINKING=low
# Gemini compares your photo with every found listing: real similarity %, wrong items hidden (~36 images per search)
VERIFY_PROVIDER=gemini
VERIFY_MAX_CANDIDATES=36
VERIFY_BATCH_SIZE=8
VERIFY_TIMEOUT_SECONDS=45
VERIFY_REJECT_BELOW=35
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=low
ANTHROPIC_SERVER_FALLBACKS=true
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODEL=
# Optional image embeddings for a real similarity %: none | jina | voyage
EMBEDDING_PROVIDER=none
EMBEDDING_DIM=1024
JINA_API_KEY=
JINA_MODEL=jina-clip-v2
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-multimodal-3
# Calibrate on your own labelled pairs before launch (docs/AI.md)
SIMILARITY_CALIBRATION_LOW=0.55
SIMILARITY_CALIBRATION_HIGH=0.93

# --- Web sources (marketplaces without an API or before their keys arrive) ---
# Search by photo: serper (Google Lens via serper.dev) | google_vision (official Cloud Vision web detection) | none
LENS_PROVIDER=serper
SERPER_API_KEY=
SERPER_COUNTRY=ru
SERPER_LANGUAGE=ru
# Google Images alongside text search: gives photos to listings found without one (+1 query per language)
SERPER_IMAGES=true
GOOGLE_VISION_API_KEY=
# Search by description: serper (Google via serper.dev) | claude (Claude web search, uses ANTHROPIC_API_KEY) | none
TEXT_SEARCH_PROVIDER=serper
WEB_SEARCH_MODEL=claude-sonnet-5-5
WEB_SEARCH_MAX_USES=5
# Marketplaces that may be served through the web sources when they have no API / no keys
WEB_SEARCH_MARKETPLACES=avito,wildberries,vinted,grailed,ebay,aliexpress,taobao

# --- Marketplaces -----------------------------------------------------------
# Listed sources. goofish stays off unless GOOFISH_ENABLED=true.
MARKETPLACES_ENABLED=ebay,aliexpress,taobao,wildberries,avito,vinted,grailed
GOOFISH_ENABLED=false

# eBay Browse API (developer.ebay.com)
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_MARKETPLACE_ID=EBAY_US
EBAY_CATEGORY_IDS=11450
EBAY_AFFILIATE_CAMPAIGN_ID=
EBAY_IMAGE_SEARCH=true

# AliExpress Affiliate API (openservice.aliexpress.com + portals.aliexpress.com)
ALIEXPRESS_APP_KEY=
ALIEXPRESS_APP_SECRET=
ALIEXPRESS_TRACKING_ID=
ALIEXPRESS_TARGET_CURRENCY=USD
ALIEXPRESS_TARGET_LANGUAGE=EN
ALIEXPRESS_SHIP_TO_COUNTRY=US

# Taobao Union / TOP (open.taobao.com + pub.alimama.com)
TAOBAO_APP_KEY=
TAOBAO_APP_SECRET=
TAOBAO_ADZONE_ID=

# --- Payments / trial seeds -------------------------------------------------
PAYMENTS_RECURRING=true
TRIAL_DAYS=3
TRIAL_AUTO_ACTIVATE=false

# --- Tuning (defaults are fine for 4 vCPU / 8 GB) ----------------------------
UPLOAD_MAX_BYTES=10485760
# Uploaded photos are deleted after N days (search history keeps its metadata)
UPLOAD_RETENTION_DAYS=90
INIT_DATA_MAX_AGE_SECONDS=86400
PROVIDER_TIMEOUT_SECONDS=20
SEARCH_TOTAL_TIMEOUT_SECONDS=90
SEARCH_RESULTS_PER_PROVIDER=40
# Process counts (defaults sized for 4 vCPU / 8 GB)
API_WORKERS=4
WORKER_PROCESSES=2
WORKER_THREADS=6
